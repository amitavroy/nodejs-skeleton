# Copy to .env:  cp .env.example .env   (npm run init does this for you)
# Host ports are offset from the defaults so they don't clash with a local Postgres/Redis.

# --- App ports (host) ---
API_PORT=3001        # NestJS API
WEB_PORT=3000        # Next.js web app (calls the API through its own /api proxy)
LOG_LEVEL=info       # fatal|error|warn|info|debug|trace|silent
LOGS_AS_FILE=false   # true = date-wise files in storage/logs/ (YYYY-MM-DD.log), false = stdout

# --- Postgres (pgvector/pgvector:pg17) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=app
DB_PASSWORD=secret
DB_NAME=app

# --- Bull Board (job dashboard at http://localhost:3001/admin/queues) ---
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin   # change outside local development

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Mail (Mailpit catches everything) ---
MAIL_DRIVER=smtp     # smtp | log (log = write mails to the log instead of sending)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@example.com

# --- Tool UIs ---
MAILPIT_PORT=8025     # http://localhost:8025
DOZZLE_PORT=9000      # http://localhost:9000
