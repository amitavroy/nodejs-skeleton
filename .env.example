# Copy to .env:  cp .env.example .env   (npm run init does this for you)
# Host ports are offset from the defaults so they don't clash with a local Postgres/Redis.

# --- Server ---
PORT=3001

# --- Postgres (pgvector/pgvector:pg17) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=app
DB_PASSWORD=secret
DB_NAME=app

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Mail (Mailpit catches everything) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@example.com

# --- Tool UIs ---
PGADMIN_PORT=5050     # http://localhost:5050
MAILPIT_PORT=8025     # http://localhost:8025
DOZZLE_PORT=9000      # http://localhost:9000
